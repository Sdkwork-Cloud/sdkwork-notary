        "notary.sdkwork.com",
        "notary.birdcoder.com",
        "notary.dtupay.com",
        "notary.sdkwork.cn",
        "notary.birdcoder.cn",
        "notary.dtupay.cn"
      ]
    },
    "application.backend-http": {
      "httpHost": "notary-admin.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "notary-admin-dev.sdkwork.com",
            "notary-admin-dev.birdcoder.com",
            "notary-admin-dev.dtupay.com",
            "notary-admin-dev.sdkwork.cn",
            "notary-admin-dev.birdcoder.cn",
            "notary-admin-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "notary-admin-test.sdkwork.com",
            "notary-admin-test.birdcoder.com",
            "notary-admin-test.dtupay.com",
            "notary-admin-test.sdkwork.cn",
            "notary-admin-test.birdcoder.cn",
            "notary-admin-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "notary-admin-staging.sdkwork.com",
            "notary-admin-staging.birdcoder.com",
            "notary-admin-staging.dtupay.com",
            "notary-admin-staging.sdkwork.cn",
            "notary-admin-staging.birdcoder.cn",
            "notary-admin-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "notary-admin.sdkwork.com",
        "notary-admin.birdcoder.com",
        "notary-admin.dtupay.com",
        "notary-admin.sdkwork.cn",
        "notary-admin.birdcoder.cn",
        "notary-admin.dtupay.cn"
      ]
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "api-dev.sdkwork.com",
            "api-dev.birdcoder.com",
            "api-dev.dtupay.com",
            "api-dev.sdkwork.cn",
            "api-dev.birdcoder.cn",
            "api-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "api-test.sdkwork.com",
            "api-test.birdcoder.com",
            "api-test.dtupay.com",
            "api-test.sdkwork.cn",
            "api-test.birdcoder.cn",
            "api-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "api-staging.sdkwork.com",
            "api-staging.birdcoder.com",
            "api-staging.dtupay.com",
            "api-staging.sdkwork.cn",
            "api-staging.birdcoder.cn",
            "api-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "api.sdkwork.com",
        "api.birdcoder.com",
        "api.dtupay.com",
        "api.sdkwork.cn",
        "api.birdcoder.cn",
        "api.dtupay.cn"
      ]
    }
  },
  "components": {
    "appApiRouter": {
      "crate": "sdkwork-routes-notary-app-api",
      "library": "sdkwork_routes_notary_app_api"
    },
    "backendApiRouter": {
      "crate": "sdkwork-routes-notary-backend-api",
      "library": "sdkwork_routes_notary_backend_api"
    }
  },
  "orchestration": {
    "profiles": {
      "cloud.development": {
        "processes": [
          {
            "id": "notary-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-notary-pc",
            "bindEnv": "SDKWORK_NOTARY_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "platform.api-gateway"
        ],
        "browserDeliveries": [
          {
            "id": "notary-adaptive-web",
            "applicationRoot": "apps/sdkwork-notary-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "notary-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-notary-pc",
                "script": "dev",
                "defaultPort": 4271,
                "portEnv": "SDKWORK_NOTARY_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-notary-h5",
                "script": "dev",
                "defaultPort": 4272,
                "portEnv": "SDKWORK_NOTARY_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "application.backend-http",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
