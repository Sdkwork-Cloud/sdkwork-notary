{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-notary",
  "applicationCode": "notary",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "cloud.development",
    "productionProfileId": "cloud.production",
    "gatewayBind": "127.0.0.1:3900",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_NOTARY_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_NOTARY_ENVIRONMENT",
    "profileId": "SDKWORK_NOTARY_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_NOTARY_DEPLOYMENT_PROFILE",
    "apiGatewayBaseUrl": "SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_NOTARY_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "notary.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "notary-dev.sdkwork.com",
            "notary-dev.birdcoder.com",
            "notary-dev.dtupay.com",
            "notary-dev.sdkwork.cn",
            "notary-dev.birdcoder.cn",
            "notary-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "notary-test.sdkwork.com",
            "notary-test.birdcoder.com",
            "notary-test.dtupay.com",
            "notary-test.sdkwork.cn",
            "notary-test.birdcoder.cn",
            "notary-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "notary-staging.sdkwork.com",
            "notary-staging.birdcoder.com",
            "notary-staging.dtupay.com",
            "notary-staging.sdkwork.cn",
            "notary-staging.birdcoder.cn",
            "notary-staging.dtupay.cn"
          ]
